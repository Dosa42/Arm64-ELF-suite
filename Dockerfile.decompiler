FROM ubuntu:24.04

ARG DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates curl file binutils unzip xz-utils tar zstd util-linux \
    python3 python3-venv python3-pip && \
    rm -rf /var/lib/apt/lists/*

COPY vendor-elf-decompiler-tool /opt/vendor-elf-decompiler-tool
RUN chmod +x /opt/vendor-elf-decompiler-tool/*.sh /opt/vendor-elf-decompiler-tool/*.py && \
    /opt/vendor-elf-decompiler-tool/install_decompiler_dependencies.sh

ENV GHIDRA_HOME=/opt/vendor-elf-decompiler-tool/.tools/ghidra_12.1.3_PUBLIC
ENV JAVA_HOME=/opt/vendor-elf-decompiler-tool/.tools/jdk21
ENV RETDEC_HOME=/opt/vendor-elf-decompiler-tool/.tools/retdec-5.0
ENV ANGR_PYTHON=/opt/vendor-elf-decompiler-tool/.tools/angr-venv/bin/python
ENV PATH=/opt/vendor-elf-decompiler-tool/.tools/jdk21/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

WORKDIR /work

